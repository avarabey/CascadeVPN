# Версии/теги upstream-образов, из которых compose соберёт и скачает контейнеры
XUI_TAG=v3.6.0
TT_VERSION=1.0.33

# Панель 3x-ui
XUI_BASE_PATH=/
XUI_PANEL_PORT=2053

# Личный портал. Хеш получите командой из корня репозитория:
#   cd portal && python3 -m app hash-password
# Пустое значение намеренно не запускает небезопасный портал без пароля.
PORTAL_PASSWORD_HASH=
PORTAL_PUBLIC_URL=https://ffknd.ru

# false блокирует RSS/мониторинг loopback, RFC1918 и link-local адресов.
# Включайте только если осознанно хотите проверять внутренние сервисы.
PORTAL_ALLOW_PRIVATE_URLS=false
