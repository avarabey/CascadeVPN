# Пример базового конфига TrustTunnel для docker-варианта.
# Отличия от templates/vpn.base.toml.example: порты и адреса рассчитаны на
# то, что TrustTunnel работает внутри контейнера (compose пробрасывает
# 443 хоста -> 8443 контейнера, см. compose/docker-compose.yml).
#
# cp vpn.base.toml.example vpn.base.toml   # и поправьте под себя

listen_address = "0.0.0.0:8443"
allow_private_network_connections = false
credentials_file = "credentials.toml"
rules_file = "rules.toml"

[metrics]
address = "0.0.0.0:1987"
request_timeout_secs = 3

# Контейнер portal разделяет network namespace с TrustTunnel и слушает их общий
# loopback. Публичный 443/tcp+udp остаётся у TrustTunnel; обычные HTTP-запросы
# он передаёт сюда, а VPN CONNECT продолжает обрабатывать как туннель.
[reverse_proxy]
server_address = "127.0.0.1:8080"
path_mask = "/"
h3_backward_compatibility = false
