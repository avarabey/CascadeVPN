# Generate locally with: python3 -m app hash-password
# Keep the resulting value only in /etc/ttx/portal.env (never in Git).
PORTAL_PASSWORD_HASH=

# Bare-metal service: the portal is intentionally reachable only over
# loopback. TrustTunnel remains the sole owner of public :443.
PORTAL_HOST=127.0.0.1
PORTAL_PORT=8080
PORTAL_DB=/var/lib/ffknd-portal/portal.db
PORTAL_PUBLIC_URL=https://ffknd.ru

PORTAL_SESSION_TTL=43200
PORTAL_COOKIE_SECURE=true
PORTAL_TRUST_PROXY=false

# Outbound checks and feeds are restricted to public addresses by default.
# Enabling private URLs also permits loopback/RFC1918, but never link-local
# metadata endpoints. Keep this false unless internal monitoring is required.
PORTAL_ALLOW_PRIVATE_URLS=false
PORTAL_ALLOWED_OUTBOUND_PORTS=80,443
PORTAL_CHECK_TIMEOUT=5
PORTAL_FEED_TIMEOUT=10
PORTAL_MONITOR_INTERVAL=60
PORTAL_FEED_REFRESH_INTERVAL=900
