# Пример базового конфига TrustTunnel (vpn.base.toml).
#
# Это ИСТОЧНИК ПРАВДЫ для оператора. ttx-bridge копирует этот файл дословно
# (байт-в-байт, включая комментарии) и добавляет ниже своя маркера ровно одну
# секцию — [forward_protocol.socks5]. Саму эту секцию сюда вписывать не нужно,
# её сгенерирует мост при первом `ttx reconcile`; если она здесь всё же
# окажется, мост её вырежет и заменит своей.
#
# Проще всего получить реальный файл через штатный мастер TrustTunnel и уже
# его использовать как базу:
#   cd /opt/trusttunnel && sudo ./setup_wizard
#   sudo cp vpn.toml /etc/ttx/vpn.base.toml
# после чего поправить вручную то, что описано ниже.

listen_address = "0.0.0.0:443"

# КРИТИЧНО: должно быть false, иначе клиент через туннель дотянется до
# loopback-сервисов сервера — в том числе до панели 3x-ui. `ttx doctor`
# проверяет именно это значение.
allow_private_network_connections = false
credentials_file = "credentials.toml"
rules_file = "rules.toml"

# Чтобы включить ICMP-пинги напрямую с сервера, добавьте таблицу [icmp]
# по официальной документации TrustTunnel.
# Внимание: SOCKS5 не переносит ICMP, поэтому такой трафик пойдёт в обход
# routing 3x-ui. По умолчанию таблица намеренно отсутствует.

[metrics]
address = "127.0.0.1:1987"
request_timeout_secs = 3
